{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "excerptle",
  "main": "tools/og-worker/worker.ts",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-09-09",
  // js/*.js is esbuild output from src/*.ts and isn't committed, so every
  // deploy (local or Workers Builds) has to make it first.
  "build": {
    "command": "npm run build"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // "/" is worker-first only so share links get their unfurl metadata
    // rewritten, so whatever runs here is on the critical path of every cold
    // page load. Keep this Worker free of WASM, fonts and node polyfills.
    "run_worker_first": ["/", "/index.html", "/og.png", "/archive", "/archive/*", "/sitemap.xml"]
  },
  // The share-card renderer and its ~3.5 MB of WASM + fonts, in a separate
  // isolate. See tools/og-worker/wrangler.jsonc; deploy that one first.
  "services": [
    { "binding": "OG", "service": "excerptle-og" }
  ]
}
