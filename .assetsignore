# Files in the repo root that must NOT be published as part of the site.
# Wrangler reads this at deploy time; a manual dashboard folder upload does
# not, so exclude these by hand there too.
backend/
tools/
tests/
# TypeScript sources; the site serves the built js/*.js.
src/
tsconfig*.json
test-results/
playwright-report/
playwright.config.*
dist/
node_modules/
.git/
.github/
.codex/
.agents/
.wrangler/
.gitignore
.assetsignore
wrangler.*
.dev.vars*
.env*
*.md
content/
*:Zone.Identifier
# Source images kept in the repo but never linked from the site. The shipped
# sizes all live in assets/.
/logo.png
/icon.png
/study_4.png
/og-image.png
/new_logo_provable.png
/vh_logo.svg
assets/promo-btz.source.html
assets/logo.png
assets/logo-1200.png
